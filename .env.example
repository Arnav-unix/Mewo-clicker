# Release signing for ./build-release.sh. Sourced by bash, so plain KEY=value.
# Copy this to .env and fill in the values. .env is gitignored.
# Quote values that contain spaces or shell characters like ( ) $ !.

P4A_RELEASE_KEYSTORE="/path/to/mewo.keystore"
P4A_RELEASE_KEYALIAS="mewo-clicker"
P4A_RELEASE_KEYSTORE_PASSWD=""
P4A_RELEASE_KEYALIAS_PASSWD=""
